# ── API Keys ─────────────────────────────────────────────────────────────────
# Only the key for the provider you actually use is required.
OPENAI_API_KEY=your-openai-api-key-here

# HuggingFace token, required for the SD3 back-end. The model is a gated repo:
# accept the license at huggingface.co/stabilityai/stable-diffusion-3-medium
# with the same account, then create a token at huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your-huggingface-token-here

# Only needed for the gemini image back-end or a gemini CHAT_MODEL.
GOOGLE_API_KEY=

# ── Prompt extraction ────────────────────────────────────────────────────────
# Any gpt-* name routes to OpenAI; gemini/medlm/med-palm names route to Vertex.
# gpt-4.1-mini costs roughly $0.65 for the full 1000-report Indiana set and has
# strong structured-output adherence. Avoid the gpt-5 reasoning family here:
# prompt_builder passes temperature=0.0, which those models reject.
CHAT_MODEL=gpt-4.1-mini

# ── Image generator ──────────────────────────────────────────────────────────
# "sd3" (local GPU), "dalle", or "gemini"
IMAGE_GENERATOR=sd3

# ── Stable Diffusion 3 ───────────────────────────────────────────────────────
SD3_MODEL_ID=stabilityai/stable-diffusion-3-medium-diffusers

# txt2img → purely synthetic output; reference X-rays are ignored.
# img2img → conditions on the patient's real X-ray as the init image.
#           Requires --images-dir and --projections-csv; records without a
#           reference image fall back to txt2img automatically.
SD3_MODE=txt2img

# Stability AI's recommended defaults for SD3 Medium.
SD3_STEPS=28
SD3_GUIDANCE_SCALE=7.0

# Fallback size when no reference image is available to match geometry against.
SD3_HEIGHT=1024
SD3_WIDTH=1024

# img2img denoising strength, 0.0-1.0. Lower preserves more of the reference.
# Useful band is ~0.5-0.8; below ~0.4 the output is a lightly filtered copy of
# a real X-ray rather than a synthetic image.
SD3_IMG2IMG_STRENGTH=0.75

# float16 is the safe default. bfloat16 needs compute capability 8.0+
# (L4/A100/4090); on a T4 it produces black images, so the loader falls back.
SD3_DTYPE=float16

# Extra comma-separated negative terms, appended to the built-in defaults.
SD3_NEGATIVE_PROMPT=

# Base seed. Each uid is offset from it, so a run is reproducible while every
# record still differs. Leave empty for non-deterministic output.
SD3_SEED=

# T5 prompt window, up to 512. The long clinical prompt goes through T5; the
# CLIP encoders are capped at 77 tokens regardless.
SD3_MAX_SEQUENCE_LENGTH=512

# Memory management. CPU offload fits SD3 Medium in a 16GB card at ~5x the
# latency. SD3_DROP_T5 frees ~10GB but leaves only the 77-token CLIP encoders,
# discarding the long-prompt path the pipeline is built around.
SD3_ENABLE_CPU_OFFLOAD=true
SD3_ENABLE_VAE_SLICING=true
SD3_DROP_T5=false

# ── Vertex AI (only for the gemini back-end) ─────────────────────────────────
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_IMAGE_LOCATION=global
VERTEX_ENDPOINT_ID=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── DALL-E (only for the dalle back-end) ─────────────────────────────────────
DALLE_MODEL=dall-e-3
DALLE_IMAGE_SIZE=1024x1024
DALLE_IMAGE_QUALITY=standard
